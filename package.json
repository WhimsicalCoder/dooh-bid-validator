{
  "name": "dooh-bid-validator",
  "version": "0.1.0",
  "description": "Check DOOH OpenRTB 2.6 bid requests from a buyer's point of view, and find the same screen sold through several SSPs.",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "bin": {
    "dooh-validate": "dist/src/cli.js",
    "dooh-screens": "dist/src/screens-cli.js"
  },
  "files": [
    "dist/src"
  ],
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test dist/test/*.test.js",
    "validate": "node dist/src/cli.js",
    "build:web": "tsc -p web && node scripts/build-web.mjs",
    "screens": "node dist/src/screens-cli.js"
  },
  "keywords": [
    "dooh",
    "pdooh",
    "openrtb",
    "programmatic",
    "adtech",
    "prebid",
    "validator"
  ],
  "license": "Apache-2.0",
  "author": "WhimsicalCoder",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhimsicalCoder/dooh-bid-validator.git"
  },
  "homepage": "https://github.com/WhimsicalCoder/dooh-bid-validator",
  "engines": {
    "node": ">=18.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.7",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  }
}
